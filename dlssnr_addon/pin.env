NR_PACKAGE_SHA256=85ca7911348a160b10c1a9456a8ef95332468d8402c11c4c4ea6593a7561989f
# The checksums that release's installer checks dlssnr.bin and dlssnr-small.bin against; stamped
# into install-model.ps1 when the add-on is packaged.
NR_MODEL_SHA256=2B41C888CF4155B8958C665BA64018AB0BD25C85FC71A2B6DB86D0D04D1F7FBD
NR_SMALL_SHA256=7E966E2639DBEC6596AA0BAC3B8761137D2C40CA8CB4ACA30DF7CA10043C6E33
