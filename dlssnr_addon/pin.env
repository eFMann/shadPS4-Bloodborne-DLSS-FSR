# The DLSSNR-AMD release the add-on is built from and packaged with (gitlab.com/mochizuki0323/DLSSNR-AMD,
# MIT). A deliberate pin, read by build.sh and the windows-nr CI job; bump every value together.
NR_TAG=v0.0.8.2
NR_COMMIT=c53878b5f0ee1656e740fdbbfd52994d02fe7bd5
# That release's Windows package: its network data, model extractor and settings file.
