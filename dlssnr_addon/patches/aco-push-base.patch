+// The captured pipeline's .user_data_limit, from its PAL metadata note.
+inline uint64_t user_data_limit(const Bytes& src) {
+    size_t pos=0;
+    while(pos<src.size()) {
+        range(src,pos,12);
+        auto ns=read<uint32_t>(src,pos),ds=read<uint32_t>(src,pos+4),type=read<uint32_t>(src,pos+8);
+        pos+=12;range(src,pos,(uint64_t(ns)+3)&~uint64_t(3));pos+=(uint64_t(ns)+3)&~uint64_t(3);
+        range(src,pos,(uint64_t(ds)+3)&~uint64_t(3));
+        if(type==32) {
+            auto m=unpack(Bytes(src.begin()+pos,src.begin()+pos+ds));
+            auto& ps=m.at("amdpal.pipelines");require(ps.kind==Value::Array && ps.items.size()==1,"PAL pipeline count");
+            return ps.items[0].at(".user_data_limit").number();
+        }
+        pos+=(uint64_t(ds)+3)&~uint64_t(3);
+    }
+    throw std::runtime_error("PAL metadata note missing");
+}
